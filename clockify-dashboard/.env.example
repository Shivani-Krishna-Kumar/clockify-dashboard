# Clockify admin/owner API key (Clockify > profile > Preferences > Advanced > API).
# Must be a workspace admin so the dashboard can read every employee's entries.
CLOCKIFY_API_KEY=PASTE_ADMIN_API_KEY_HERE
WORKSPACE_ID=6a1ac12aa659907bd6685b1b

# Office timezone used to decide which calendar day an entry belongs to (IANA name).
# Leave blank to use this machine's timezone.
OFFICE_TZ=

# Default hours expected per employee per working day (override per person in the Team settings tab).
EXPECTED_HOURS=8
# ISO weekdays that are working days: 1=Mon ... 7=Sun
WORKING_DAYS=1,2,3,4,5
# Comma-separated YYYY-MM-DD dates nobody is expected to log
HOLIDAYS=
# Projects that do NOT count as work (excluded from hours and percentages)
EXCLUDED_PROJECTS=Lunch Break

# node-cron expression for the automatic sync (default: hourly, 08:00-20:00 office time)
SYNC_CRON=0 8-20 * * *

PORT=3000
HOST=0.0.0.0
# Shared password for the dashboard (browser asks for it; username can be anything).
# If empty the dashboard is open to anyone who can reach it.
DASHBOARD_PASSWORD=
